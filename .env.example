# Copy this file to .env and fill in real values. Never commit the real .env file.

# Postgres connection string. Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clinic_db

# Set to "true" only in local development. Logs full SQL queries when true.
DEBUG=false

# Comma-separated list of allowed frontend origins, or "*" for local dev only.
# e.g. CORS_ORIGINS=https://myclinic.com,https://admin.myclinic.com
CORS_ORIGINS=*
